          "sort": "none"
        }
      },
      "title": "Error Count (5xx / Failures)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_errors_total[1m])) or sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "Error Rate (5xx / Failures)",
          "range": true,
          "refId": "A"
        }
      ]
